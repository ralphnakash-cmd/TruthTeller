# ── Veritas configuration ─────────────────────────────────────────────
# Copy to .env.local (never commit it). All keys stay server-side.

# REQUIRED for live verification — Claude does claim extraction and evidence evaluation.
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# STRONGLY RECOMMENDED — live web search (free tier available). https://app.tavily.com/
# Without it, evidence comes from Wikipedia only and many claims will be UNVERIFIED.
TAVILY_API_KEY=

# OPTIONAL — alternative web search, used only if TAVILY_API_KEY is empty.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# OPTIONAL — Google Fact Check Tools API (ClaimReview data from fact-checkers).
# https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=

# OPTIONAL — model overrides (defaults shown)
# VERITAS_FAST_MODEL=claude-haiku-5-5
# VERITAS_SMART_MODEL=claude-sonnet-5-5

# OPTIONAL — contact string sent in the Wikipedia User-Agent (Wikimedia asks for one)
# VERITAS_CONTACT=you@example.com

# OPTIONAL — UI-only demo without any keys. Clearly labelled; never used as a fallback.
# VERITAS_DEMO_MODE=true

# OPTIONAL — limits and cost controls
# VERITAS_RATE_LIMIT_PER_MIN=12
# VERITAS_MAX_INPUT_CHARS=600
# VERITAS_MAX_CLAIMS=4
# VERITAS_MAX_QUERIES=3
# VERITAS_RESULTS_PER_QUERY=5
# VERITAS_MAX_SOURCES=8
# VERITAS_SEARCH_TIMEOUT_MS=8000
# VERITAS_LLM_TIMEOUT_MS=30000
# VERITAS_CACHE_TTL_MS=21600000
# VERITAS_DISABLE_WIKIPEDIA=false
